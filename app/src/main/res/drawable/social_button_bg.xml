<!-- res/drawable/social_button_bg.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Slight transparent grey -->
    <solid android:color="#1A000000" /> <!-- 1A = ~10% opacity -->

    <corners android:radius="12dp" />

    <!-- Optional: subtle border for elevation feel -->
