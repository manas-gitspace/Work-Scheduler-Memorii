<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView 
    android:id="@+id/editTaskLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auroraBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/animHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:alpha="0">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back_premium"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="?attr/customTextPrimary" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Task"
                android:textColor="?attr/customTextPrimary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- TASK NAME CARD -->
        <LinearLayout
            android:id="@+id/animTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:alpha="0">

            <EditText
                android:id="@+id/taskNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="?attr/customTextPrimary"
                android:textColorHint="?attr/customTextMuted"
                android:textSize="22sp"
                android:textStyle="bold"
                android:hint="What are you planning?"
                android:singleLine="true" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/customTextMuted"
                android:layout_marginTop="12dp"
                android:alpha="0.3"/>
        </LinearLayout>

        <!-- DATE & TIME ROW (2 Columns) -->
        <LinearLayout
            android:id="@+id/animDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:alpha="0">

            <!-- DATE CARD -->
            <LinearLayout
                android:id="@+id/datePickerCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/glass_card"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_calendar_premium"
                    app:tint="@color/accent_lilac"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="?attr/customTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/taskDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="?attr/customTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- TIME CARD -->
            <LinearLayout
                android:id="@+id/timePickerCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/glass_card"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_time_premium"
                    app:tint="@color/accent_teal"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="?attr/customTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/taskTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not set"
                    android:textColor="?attr/customTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRIORITY SELECTION -->
        <LinearLayout
            android:id="@+id/animPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="20dp"
            android:layout_marginBottom="32dp"
            android:elevation="2dp"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority"
                android:textColor="?attr/customTextMuted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:layout_marginBottom="16dp" />

            <!-- HORIZONTAL PRIORITY CHIPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/chipCritical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Critical"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/glass_card"
                    android:textColor="?attr/customTextSecondary"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/glass_card_active"
                    android:textColor="@color/accent_gold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/glass_card"
                    android:textColor="?attr/customTextSecondary"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipLow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Low"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:background="@drawable/glass_card"
                    android:textColor="?attr/customTextSecondary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- REMINDER SECTION -->
        <LinearLayout
            android:id="@+id/animReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="20dp"
            android:layout_marginBottom="32dp"
            android:elevation="2dp"
            android:alpha="0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/accent_gold"
                    android:layout_marginEnd="12dp" />
                    
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Reminder"
                    android:textColor="?attr/customTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />
                    
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
            
            <View
                android:id="@+id/reminderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/customTextMuted"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.3"/>
                
            <LinearLayout
                android:id="@+id/ringtoneSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ringtone"
                    app:tint="?attr/customTextSecondary"
                    android:layout_marginEnd="12dp" />
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ringtone"
                        android:textColor="?attr/customTextPrimary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                        
                    <TextView
                        android:id="@+id/textSelectedRingtone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Ringtone"
                        android:textColor="?attr/customTextMuted"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SAVE BUTTON -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Task"
            android:textColor="#FF000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_gradient"
            android:elevation="8dp"
            android:translationZ="4dp"
            android:letterSpacing="0.02" 
            android:alpha="0"/>

        <android.widget.Space
            android:layout_width="0dp"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>

    <android.webkit.WebView
        android:id="@+id/tutorialTaskWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        android:elevation="20dp"
        android:background="@android:color/transparent" />
</FrameLayout>
