<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auroraBackground">

    <ImageView
        android:id="@+id/onboardingImage"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/bg6"
        android:layout_marginTop="56dp"
        android:layout_centerHorizontal="true"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:contentDescription="Memorii Illustration" />

    <LinearLayout
        android:id="@+id/onboardingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/onboardingImage"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        android:background="@drawable/glass_card_elevated"
        android:padding="28dp"
        android:alpha="0"
        android:translationY="30dp">

        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organize Your Day"
            android:textColor="?attr/customTextPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/onboardingDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart scheduling, task reminders, and better productivity — all in one place."
            android:textColor="?attr/customTextSecondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_gravity="center_horizontal"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/nextBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="44dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_button_gradient"
        android:fontFamily="sans-serif-medium"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#FF000000"
        android:textSize="16sp"
        android:alpha="0"
        android:translationY="20dp"
        android:letterSpacing="0.02" />
</RelativeLayout>
