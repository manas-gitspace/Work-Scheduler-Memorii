<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <com.example.workscheduler.SplashOrbitalView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Splash Graphic Center -->
    <FrameLayout
        android:id="@+id/splashLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toTopOf="@+id/splashTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="32dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lightbulb_glow"
            app:tint="#FFFFFF" />
            
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_particle_white"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-5dp"
            android:backgroundTint="#5DCAA5" />
    </FrameLayout>

    <!-- Splash Title -->
    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Memorii"
        android:textColor="#EEEDFE"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@+id/splashSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashLogo"
        android:layout_marginBottom="8dp"/>

    <!-- Splash Subtitle -->
    <TextView
        android:id="@+id/splashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="your memory, always with you"
        android:textColor="#9FE1CB"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/splashGetStartedBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashTitle"
        android:layout_marginBottom="64dp"/>

    <!-- Get Started Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/splashGetStartedBtn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_gradient"
        android:text="Get started"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:elevation="8dp"
        android:translationZ="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashSubtitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
