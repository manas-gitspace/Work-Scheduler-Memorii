<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title and Target Date -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schedule Actions"
        android:textColor="?attr/customTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thursday, June 25"
        android:textColor="?attr/customTextSecondary"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Copy Option Card -->
    <LinearLayout
        android:id="@+id/btnCopyAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCopyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy Day's Schedule"
                android:textColor="?attr/customTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCopyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copies all schedules of this date"
                android:textColor="?attr/customTextMuted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/iconCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="24sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Paste Option Card -->
    <LinearLayout
        android:id="@+id/btnPasteAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/glass_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPasteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paste Schedule"
                android:textColor="?attr/customTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPasteDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paste from clipboard"
                android:textColor="?attr/customTextMuted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/iconPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥"
            android:textSize="24sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/btnCancelAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="?attr/customTextSecondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
