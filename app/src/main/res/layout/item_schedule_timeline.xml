<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <!-- Left: Time Label -->
    <TextView
        android:id="@+id/textTimeLabel"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="07:30"
        android:textColor="?attr/customTextMuted"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="12dp" />

    <!-- Center: Timeline Line + Dot -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">

        <!-- Vertical Line (full height) -->
        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_timeline_line" />

        <!-- Colored Dot (positioned at top) -->
        <View
            android:id="@+id/timelineDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_timeline_dot" />
    </FrameLayout>

    <!-- Right: Schedule Card -->
    <LinearLayout
        android:id="@+id/scheduleCardRoot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_schedule_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <!-- Top Row: Category Badge + Overflow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Category Dot -->
            <View
                android:id="@+id/categoryDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_timeline_dot" />

            <!-- Category/Priority Badge -->
            <TextView
                android:id="@+id/textCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELLNESS"
                android:textColor="?attr/customTextSecondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:layout_marginStart="6dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Alarm Icon -->
            <ImageView
                android:id="@+id/iconAlarm"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_alarm"
                app:tint="?attr/customTextMuted"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morning reset"
            android:textColor="?attr/customTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Subtitle: Duration -->
        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 min"
            android:textColor="?attr/customTextMuted"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
