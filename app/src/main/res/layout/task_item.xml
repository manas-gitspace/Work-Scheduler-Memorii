<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/glassBorder"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/glassBg"
    app:rippleColor="@color/ripple_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/taskStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/priority_badge"
            android:backgroundTint="@color/accent_lilac" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/customTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Complete project" />

                <TextView
                    android:id="@+id/taskPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/priority_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textAllCaps="true"
                    android:textColor="?attr/customTextPrimary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="HIGH" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_schedule_notification"
                    app:tint="?attr/customTextMuted"
                    android:contentDescription="Time" />

                <TextView
                    android:id="@+id/taskTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/customTextSecondary"
                    android:textSize="12sp"
                    tools:text="10:00 AM" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/taskAlertIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_urgent_notification"
                    app:tint="@color/accent_rose"
                    android:visibility="gone"
                    android:contentDescription="Alert" />
            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/taskCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:buttonTint="@color/accent_teal"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
