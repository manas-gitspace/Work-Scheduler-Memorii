<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="14dp"
        android:paddingHorizontal="4dp">

        <!-- Time Pill -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_time_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:id="@+id/widgetItemTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Glowing Priority Dot -->
        <ImageView
            android:id="@+id/widgetItemDot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/dot_glow_medium" />

        <!-- Title -->
        <TextView
            android:id="@+id/widgetItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Morning medication"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Alarm Icon -->
        <ImageView
            android:id="@+id/widgetItemAlarm"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_alarm"
            android:contentDescription="Alarm enabled" />
    </LinearLayout>

    <!-- Subtle Divider (Matches image) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12FFFFFF"
        android:layout_marginHorizontal="4dp"
        android:contentDescription="Divider" />

</LinearLayout>
