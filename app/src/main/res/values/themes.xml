<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Dark Theme -->
    <style name="Base.Theme.WorkScheduler" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/accent_lilac_20</item>
        <item name="colorOnPrimaryContainer">@color/accent_lilac</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/accent_teal_20</item>
        <item name="colorOnSecondaryContainer">@color/accent_teal</item>
        <item name="colorTertiary">@color/accent_gold</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/accent_gold_20</item>
        <item name="colorOnTertiaryContainer">@color/accent_gold</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/glass_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="auroraBackground">@drawable/aurora_bg</item>
        <item name="colorOutline">@color/glass_border</item>
        <item name="customTextPrimary">@color/text_primary</item>
        <item name="customTextSecondary">@color/text_secondary</item>
        <item name="customTextMuted">@color/text_muted</item>
        <item name="glassBg">@color/glass_bg</item>
        <item name="glassBorder">@color/glass_border</item>
        <item name="glassBgActive">@color/glass_bg_active</item>
        <item name="glassBorderActive">@color/glass_border_active</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="toolbarStyle">@style/Widget.WorkScheduler.Toolbar</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationStyle</item>
    </style>

    <style name="Theme.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/ic_launcher_memorii_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.WorkScheduler" parent="Base.Theme.WorkScheduler" />

    <!-- Light Theme -->
    <style name="Theme.WorkScheduler.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/calendar_selected</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_lilac_20</item>
        <item name="colorOnPrimaryContainer">@color/calendar_selected</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_teal_20</item>
        <item name="colorOnSecondaryContainer">@color/accent_teal</item>
        <item name="colorTertiary">@color/accent_teal</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/accent_teal_20</item>
        <item name="colorOnTertiaryContainer">@color/accent_teal</item>
        <item name="android:colorBackground">@color/bg_primary_light</item>
        <item name="colorSurface">@color/bg_surface_light</item>
        <item name="colorSurfaceVariant">@color/bg_elevated_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="auroraBackground">@drawable/aurora_bg_light</item>
        <item name="colorOutline">@color/glass_border_light</item>
        <item name="customTextPrimary">@color/text_primary_light</item>
        <item name="customTextSecondary">@color/text_secondary_light</item>
        <item name="customTextMuted">@color/text_muted_light</item>
        <item name="glassBg">@color/glass_bg_light</item>
        <item name="glassBorder">@color/glass_border_light</item>
        <item name="glassBgActive">@color/glass_bg_active_light</item>
        <item name="glassBorderActive">@color/glass_border_active_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_primary_light</item>
        <item name="toolbarStyle">@style/Widget.WorkScheduler.Toolbar.Light</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationStyle</item>
    </style>

    <!-- Medium Theme -->
    <style name="Theme.WorkScheduler.Medium" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/accent_lilac_20</item>
        <item name="colorOnPrimaryContainer">@color/accent_lilac</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/accent_teal_20</item>
        <item name="colorOnSecondaryContainer">@color/accent_teal</item>
        <item name="colorTertiary">@color/accent_gold</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/accent_gold_20</item>
        <item name="colorOnTertiaryContainer">@color/accent_gold</item>
        <item name="android:colorBackground">@color/bg_primary_medium</item>
        <item name="colorSurface">@color/bg_surface_medium</item>
        <item name="colorSurfaceVariant">@color/bg_elevated_medium</item>
        <item name="colorOnSurface">@color/text_primary_medium</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_medium</item>
        <item name="auroraBackground">@drawable/aurora_bg_medium</item>
        <item name="colorOutline">@color/glass_border</item>
        <item name="customTextPrimary">@color/text_primary_medium</item>
        <item name="customTextSecondary">@color/text_secondary_medium</item>
        <item name="customTextMuted">@color/text_muted_medium</item>
        <item name="glassBg">@color/glass_bg</item>
        <item name="glassBorder">@color/glass_border</item>
        <item name="glassBgActive">@color/glass_bg_active</item>
        <item name="glassBorderActive">@color/glass_border_active</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_primary_medium</item>
        <item name="toolbarStyle">@style/Widget.WorkScheduler.Toolbar.Medium</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationStyle</item>
    </style>

    <!-- Activity Transition Animations -->
    <style name="WindowAnimationStyle" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
    </style>

    <!-- Toolbar Styles -->
    <style name="Widget.WorkScheduler.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarSubtitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.WorkScheduler.Toolbar.Light" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarTitle.Light</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarSubtitle.Light</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.WorkScheduler.Toolbar.Medium" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.WorkScheduler.ToolbarSubtitle</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.WorkScheduler.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.WorkScheduler.ToolbarTitle.Light" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.WorkScheduler.ToolbarSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.WorkScheduler.ToolbarSubtitle.Light" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary_light</item>
    </style>

    <!-- AlertDialog Styles -->
    <style name="AlertDialog.WorkScheduler" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="dialogCornerRadius">20dp</item>
    </style>

    <style name="AlertDialog.WorkScheduler.Light" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="colorSurface">@color/bg_surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="dialogCornerRadius">20dp</item>
    </style>

    <style name="AlertDialog.WorkScheduler.Medium" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorSurface">@color/bg_surface_medium</item>
        <item name="colorOnSurface">@color/text_primary_medium</item>
        <item name="colorPrimary">@color/accent_lilac</item>
        <item name="android:textColorPrimary">@color/text_primary_medium</item>
        <item name="android:textColorSecondary">@color/text_secondary_medium</item>
        <item name="dialogCornerRadius">20dp</item>
    </style>
</resources>
